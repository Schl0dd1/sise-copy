# Apache-Konfiguration für den Hetzner-Webspace (wird von Hugo nach public/ kopiert)

# ---------- Fehlerseite ----------
ErrorDocument 404 /404.html

# ---------- Keine Verzeichnislisten ----------
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen – erst aktivieren, wenn das SSL-Zertifikat im Hetzner-Konto eingerichtet ist:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ---------- Weiterleitungen von alten Adressen (Umbau der Seitenstruktur, Nov. 2026) ----------
  RewriteRule ^wer-wir-sind/?$ /ueber-uns/ [R=301,L]
  RewriteRule ^podcasts/?(.*)$ /was-wir-machen/podcast/$1 [R=301,L]
  RewriteRule ^workshops/?$ /was-wir-machen/workshops/ [R=301,L]
  RewriteRule ^vortraege/?$ /was-wir-machen/vortraege/ [R=301,L]
  RewriteRule ^materialien/?$ /was-wir-machen/materialien/ [R=301,L]
  RewriteRule ^gallery/?(.*)$ /beitraege/galerie/$1 [R=301,L]
  RewriteRule ^termine/?(.*)$ /veranstaltungen/$1 [R=301,L]
  RewriteRule ^posts(/.*)?$ / [R=301,L]
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML und das CMS immer frisch laden
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  # Schriften und Bilder lange zwischenspeichern
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  # CSS hat im Dateinamen einen Fingerabdruck und ändert sich nie unter demselben Namen
  ExpiresByType text/css "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Sicherheit ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
